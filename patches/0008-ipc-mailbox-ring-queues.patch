+/// Byte mailboxes for IPC: a small FIFO ring of messages per pid (patch
+/// 0008). Replaces the earlier single-slot box where a second message
+/// before the daemon's next RECV silently overwrote the first. Runs
+/// ALONGSIDE the field's energy transport (which stays untouched) so
+/// SYS_IPC_SEND/RECV deliver actual message bytes.
 const IPC_MAX_PIDS: usize = 16;
 const IPC_MAX_BYTES: usize = 255;
+/// Messages queued per pid before the oldest is dropped. 4 is enough for
+/// bursty command-driven IPC while keeping the static footprint small
+/// (16 pids x 4 x 255 B ~= 16 KiB).
+const IPC_QUEUE_DEPTH: usize = 4;
 
 #[derive(Clone, Copy)]
 struct IpcMailbox {
-    len: usize,
-    bytes: [u8; IPC_MAX_BYTES],
+    /// Number of queued messages (0..=IPC_QUEUE_DEPTH).
+    count: usize,
+    /// Slot index of the OLDEST queued message (ring head).
+    head: usize,
+    lens: [usize; IPC_QUEUE_DEPTH],
+    bytes: [[u8; IPC_MAX_BYTES]; IPC_QUEUE_DEPTH],
 }
 
 impl IpcMailbox {
     const fn new() -> Self {
-        Self { len: 0, bytes: [0u8; IPC_MAX_BYTES] }
+        Self {
+            count: 0,
+            head: 0,
+            lens: [0; IPC_QUEUE_DEPTH],
+            bytes: [[0u8; IPC_MAX_BYTES]; IPC_QUEUE_DEPTH],
+        }
+    }
+
+    /// Enqueue one message. When the ring is full the OLDEST message is
+    /// dropped (newest kept) — a deliberate generalization of the old
+    /// latest-wins semantics, so a slow receiver never loses the freshest
+    /// traffic.
+    fn push(&mut self, msg: &[u8]) {
+        if self.count == IPC_QUEUE_DEPTH {
+            self.head = (self.head + 1) % IPC_QUEUE_DEPTH;
+            self.count -= 1;
+        }
+        let idx = (self.head + self.count) % IPC_QUEUE_DEPTH;
+        let n = msg.len().min(IPC_MAX_BYTES);
+        for i in 0..n {
+            self.bytes[idx][i] = msg[i];
+        }
+        self.lens[idx] = n;
+        self.count += 1;
+    }
+
+    /// Dequeue the oldest message into `out`, returning its length, or
+    /// None if the queue is empty.
+    fn pop(&mut self, out: &mut [u8; IPC_MAX_BYTES]) -> Option<usize> {
+        if self.count == 0 {
+            return None;
+        }
+        let idx = self.head;
+        let n = self.lens[idx];
+        *out = self.bytes[idx];
+        self.head = (idx + 1) % IPC_QUEUE_DEPTH;
+        self.count -= 1;
+        Some(n)
     }
 }
 

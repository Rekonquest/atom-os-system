+    /// Rewrite the diff-walk baseline of every task holding `old` to `new`
+    /// (patch 0007). Called at EXEC, before the replaced root `old` is
+    /// freed. Sound because each affected task replaced the only region
+    /// where `old` differs from `new`'s lineage (the image/stack chain)
+    /// with its own private chain at creation — its diff-walk frees the
+    /// identical frame set against either baseline.
+    pub fn rebaseline(&mut self, old: u64, new: u64) {
+        for t in self.tasks.iter_mut().flatten() {
+            if t.parent_pml4 == old {
+                t.parent_pml4 = new;
+            }
+        }
+    }
+
+    /// True if any task's current address space can reach `frame` through
+    /// its page tables (patch 0007). Used to protect frames that other
+    /// roots still reference — e.g. an IPC RECV chain inherited by shallow
+    /// copy — when an EXEC-replaced address space is freed.
+    pub fn root_reaches(&self, frame: u64) -> bool {
+        for t in self.tasks.iter().flatten() {
+            if kernel_kit::paging::frame_reachable(t.page_table_root, frame) {
+                return true;
+            }
+        }
+        false
+    }

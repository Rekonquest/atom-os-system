+/// Zero the leaf PTEs of `pml4` mapping the virtual range
+/// [vaddr_start, vaddr_start + bytes) (patch 0007). Used when a freshly
+/// copied address space must not keep aliases into the source task's
+/// image frames: after `unshare_page_path` the private PT still holds the
+/// source's PTEs; this clears them before `map_segment` writes the new
+/// ones. Absent intermediate levels are skipped (nothing to clear).
+/// Contract: `pml4_phys` must not be any running task's active CR3 (the
+/// fresh copy is not loaded until the syscall return path switches to it,
+/// so no TLB shootdown is needed).
+pub fn clear_ptes_range(pml4_phys: u64, vaddr_start: u64, bytes: usize) {
+    if bytes == 0 || pml4_phys == 0 {
+        return;
+    }
+    let mut va = vaddr_start & !0xFFF;
+    let end = vaddr_start + bytes as u64;
+    unsafe {
+        while va < end {
+            let v = VirtualAddress(va);
+            let pml4 = &mut *(phys_to_virt(pml4_phys) as *mut PageTable);
+            let p4 = pml4.entries[v.p4_index()].0;
+            if (p4 & 1) != 0 && (p4 & (1 << 7)) == 0 {
+                let pdpt = &mut *(phys_to_virt(p4 & 0x000FFFFFFFFFF000) as *mut PageTable);
+                let p3 = pdpt.entries[v.p3_index()].0;
+                if (p3 & 1) != 0 && (p3 & (1 << 7)) == 0 {
+                    let pd = &mut *(phys_to_virt(p3 & 0x000FFFFFFFFFF000) as *mut PageTable);
+                    let p2 = pd.entries[v.p2_index()].0;
+                    if (p2 & 1) != 0 && (p2 & (1 << 7)) == 0 {
+                        let pt = &mut *(phys_to_virt(p2 & 0x000FFFFFFFFFF000) as *mut PageTable);
+                        pt.entries[v.p1_index()].0 = 0;
+                    }
+                }
+            }
+            va += PAGE_SIZE;
+        }
+    }
+}
+
+/// Collect (without freeing) the exact frame set `free_private_tables`
+/// would release, EXCLUDING `child_pml4` itself (the caller handles the
+/// root frame). Returns the count written to `out`; truncates silently at
+/// `out` capacity (truncation only ever turns a free into a leak — never
+/// unsafe). Patch 0007 uses this for EXEC-time freeing, where each frame
+/// needs an individual reachability check before release.
+pub fn collect_private_frames(child_pml4: u64, parent_pml4: u64, out: &mut [u64]) -> usize {
+    if child_pml4 == 0 || parent_pml4 == 0 || child_pml4 == parent_pml4 {
+        return 0;
+    }
+    let mut n = 0;
+    unsafe {
+        let child = &*(phys_to_virt(child_pml4) as *const PageTable);
+        let parent = &*(phys_to_virt(parent_pml4) as *const PageTable);
+        for i in 0..512 {
+            let c = child.entries[i].0;
+            if (c & 1) == 0 { continue; }
+            if (c & (1 << 7)) != 0 { continue; } // reserved at PML4; skip defensively
+            let c_addr = c & 0x000FFFFFFFFFF000;
+            let p = parent.entries[i].0;
+            if (p & 1) != 0 && (p & 0x000FFFFFFFFFF000) == c_addr {
+                continue; // shared subtree
+            }
+            let parent_next = if (p & 1) != 0 {
+                Some(p & 0x000FFFFFFFFFF000)
+            } else {
+                None
+            };
+            n = collect_table_subtree(c_addr, parent_next, 3, out, n);
+            if n < out.len() {
+                out[n] = c_addr;
+                n += 1;
+            }
+        }
+    }
+    n
+}
+
+unsafe fn collect_table_subtree(
+    tbl_phys: u64,
+    parent_tbl: Option<u64>,
+    level: usize,
+    out: &mut [u64],
+    n_in: usize,
+) -> usize {
+    unsafe {
+        let mut n = n_in;
+        let tbl = &*(phys_to_virt(tbl_phys) as *const PageTable);
+        for i in 0..512 {
+            let e = tbl.entries[i].0;
+            if (e & 1) == 0 { continue; }
+            if (e & (1 << 7)) != 0 { continue; } // huge leaf: data, copied from parent
+            let e_addr = e & 0x000FFFFFFFFFF000;
+            let mut pe: u64 = 0;
+            if let Some(pt_phys) = parent_tbl {
+                let pt = &*(phys_to_virt(pt_phys) as *const PageTable);
+                pe = pt.entries[i].0;
+                if (pe & 1) != 0 && (pe & 0x000FFFFFFFFFF000) == e_addr {
+                    continue; // shared at this level too
+                }
+            }
+            if level > 1 {
+                let parent_next = if (pe & 1) != 0 {
+                    Some(pe & 0x000FFFFFFFFFF000)
+                } else {
+                    None
+                };
+                n = collect_table_subtree(e_addr, parent_next, level - 1, out, n);
+                if n < out.len() {
+                    out[n] = e_addr;
+                    n += 1;
+                }
+            }
+            // level == 1: e_addr is a leaf data frame — tracked elsewhere.
+        }
+        n
+    }
+}
+
+/// True iff the page-table frame `target` is reachable from the tree
+/// rooted at `root_phys` — i.e. it IS `root_phys`, or some table in the
+/// tree points at it (directly or transitively). Leaf data frames are not
+/// followed. Patch 0007 uses this to protect frames that other address
+/// spaces still reference when freeing an EXEC-replaced address space.
+pub fn frame_reachable(root_phys: u64, target: u64) -> bool {
+    if root_phys == 0 {
+        return false;
+    }
+    if root_phys == target {
+        return true;
+    }
+    // The root is a PML4; its entries target PDPTs (level 3).
+    unsafe { reachable_below(root_phys, target, 3) }
+}
+
+unsafe fn reachable_below(tbl_phys: u64, target: u64, level: usize) -> bool {
+    unsafe {
+        let tbl = &*(phys_to_virt(tbl_phys) as *const PageTable);
+        for i in 0..512 {
+            let e = tbl.entries[i].0;
+            if (e & 1) == 0 { continue; }
+            if (e & (1 << 7)) != 0 { continue; } // huge leaf: data region
+            let e_addr = e & 0x000FFFFFFFFFF000;
+            if e_addr == target {
+                return true;
+            }
+            if level > 1 && reachable_below(e_addr, target, level - 1) {
+                return true;
+            }
+        }
+        false
+    }
+}

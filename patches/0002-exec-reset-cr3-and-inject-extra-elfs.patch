+
+/// Clone every level of the page-table walk for `vaddr` so subsequent
+/// `map_segment` stores into private tables. `duplicate_pml4` is shallow —
+/// without this, runtime SYS_EXEC overwrites leaf PTEs shared with the
+/// caller's (and possibly the kernel's) page tables and #GPs.
+pub fn unshare_page_path(pml4_phys: u64, vaddr: u64) {
+    let va = VirtualAddress(vaddr);
+    unsafe {
+        let pml4 = &mut *(phys_to_virt(pml4_phys) as *mut PageTable);
+        let p4 = pml4.entries[va.p4_index()].0;
+        if (p4 & 1) == 0 {
+            return;
+        }
+        let old_pdpt = p4 & 0x000FFFFFFFFFF000;
+        let (fa, sif) = crate::memory::FRAME_ALLOCATOR.lock();
+        let new_pdpt = match fa.alloc_frame() {
+            Some(f) => f,
+            None => { crate::memory::FRAME_ALLOCATOR.unlock(sif); return; }
+        };
+        crate::memory::FRAME_ALLOCATOR.unlock(sif);
+        core::ptr::copy_nonoverlapping(
+            phys_to_virt(old_pdpt) as *const PageTable,
+            phys_to_virt(new_pdpt) as *mut PageTable,
+            1,
+        );
+        pml4.entries[va.p4_index()].0 = new_pdpt | (p4 & 0xFFF);
+
+        let pdpt = &mut *(phys_to_virt(new_pdpt) as *mut PageTable);
+        let p3 = pdpt.entries[va.p3_index()].0;
+        if (p3 & 1) == 0 {
+            return;
+        }
+        let old_pd = p3 & 0x000FFFFFFFFFF000;
+        let (fa, sif) = crate::memory::FRAME_ALLOCATOR.lock();
+        let new_pd = match fa.alloc_frame() {
+            Some(f) => f,
+            None => { crate::memory::FRAME_ALLOCATOR.unlock(sif); return; }
+        };
+        crate::memory::FRAME_ALLOCATOR.unlock(sif);
+        core::ptr::copy_nonoverlapping(
+            phys_to_virt(old_pd) as *const PageTable,
+            phys_to_virt(new_pd) as *mut PageTable,
+            1,
+        );
+        pdpt.entries[va.p3_index()].0 = new_pd | (p3 & 0xFFF);
+
+        let pd = &mut *(phys_to_virt(new_pd) as *mut PageTable);
+        let p2 = pd.entries[va.p2_index()].0;
+        if (p2 & 1) == 0 {
+            return;
+        }
+        let old_pt = p2 & 0x000FFFFFFFFFF000;
+        let (fa, sif) = crate::memory::FRAME_ALLOCATOR.lock();
+        let new_pt = match fa.alloc_frame() {
+            Some(f) => f,
+            None => { crate::memory::FRAME_ALLOCATOR.unlock(sif); return; }
+        };
+        crate::memory::FRAME_ALLOCATOR.unlock(sif);
+        core::ptr::copy_nonoverlapping(
+            phys_to_virt(old_pt) as *const PageTable,
+            phys_to_virt(new_pt) as *mut PageTable,
+            1,
+        );
+        pd.entries[va.p2_index()].0 = new_pt | (p2 & 0xFFF);
+    }
+}

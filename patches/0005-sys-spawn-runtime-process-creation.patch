+/// Look up `filename` in the RamFS root and return a pointer to its data
+/// vector. The lock is released before return; RamFS nodes live for the
+/// whole boot, so the pointed-to Vec stays valid (same hazard class as the
+/// pre-existing EXEC path).
+fn ramfs_file_ptr(filename: &str) -> Option<*const alloc::vec::Vec<u8>> {
+    let fs = kernel_kit::fs::ROOT_FS.lock();
+    let mut found = None;
+    if let kernel_kit::fs::AtomNode::Directory(children) = &*fs {
+        for (name, node) in children {
+            if name == filename {
+                if let kernel_kit::fs::AtomNode::File(data) = node {
+                    found = Some(data as *const alloc::vec::Vec<u8>);
+                }
+                break;
+            }
+        }
+    }
+    kernel_kit::fs::ROOT_FS.unlock();
+    found
+}

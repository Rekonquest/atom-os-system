+/// Load an ELF image into a fresh user address space derived from the
+/// ACTIVE CR3 (the kernel half stays shared). Returns (entry, new_pml4_phys)
+/// or None. Panics on frame-allocator OOM, matching the pre-existing EXEC
+/// behavior. Used by both SYS_EXEC (replace caller) and SYS_SPAWN (new task).
+fn load_user_image(elf_bytes: &[u8]) -> Option<(u64, u64)> {
+    if elf_bytes.len() < core::mem::size_of::<kernel_kit::elf::Elf64_Ehdr>() {
+        return None;
+    }
+    let ehdr_ptr = elf_bytes.as_ptr() as *const kernel_kit::elf::Elf64_Ehdr;
+    let ehdr = unsafe { &*ehdr_ptr };
+    if !ehdr.is_valid() {
+        return None;
+    }
+    let phoff = ehdr.e_phoff as usize;
+    let phnum = ehdr.e_phnum as usize;
+
+    let active_cr3 = kernel_kit::paging::Cr3::read();
+    let new_cr3 = match kernel_kit::paging::duplicate_pml4(active_cr3) {
+        Some(c) => c,
+        None => return None, // OOM duplicating PML4
+    };
+    // Private page-table path for user image + stack so
+    // map_segment does not mutate tables shared with the caller.
+    kernel_kit::paging::unshare_page_path(new_cr3, 0xFFFFFFFF80100000);
+    kernel_kit::paging::unshare_page_path(new_cr3, 0xFFFFFFFF800FE000);
+    // PASS 1: scan phdrs to find the virtual span [vmin, vmax).
+    let mut vmin: u64 = u64::MAX;
+    let mut vmax: u64 = 0;
+    for i in 0..phnum {
+        let phdr_ptr = unsafe { elf_bytes.as_ptr().add(phoff + i * core::mem::size_of::<kernel_kit::elf::Elf64_Phdr>()) as *const kernel_kit::elf::Elf64_Phdr };
+        let phdr = unsafe { &*phdr_ptr };
+        if phdr.p_type == 1 { // PT_LOAD
+            let v = phdr.p_vaddr;
+            let m = phdr.p_memsz;
+            if v < vmin { vmin = v; }
+            if v + m > vmax { vmax = v + m; }
+        }
+    }
+    // Allocate ONE contiguous run of frames covering the whole span,
+    // page-aligned (see patch 0002 for the boundary-page rationale).
+    let span_start_vaddr = vmin & !0xFFF;
+    let span_end_vaddr = (vmax + 0xFFF) & !0xFFF;
+    let span_bytes = (span_end_vaddr - span_start_vaddr) as usize;
+    let span_nframes = (span_bytes + 0xFFF) / 0x1000;
+    let span_phys = {
+        let (fa, sif) = kernel_kit::memory::FRAME_ALLOCATOR.lock();
+        let r = fa.alloc_contiguous(span_nframes);
+        kernel_kit::memory::FRAME_ALLOCATOR.unlock(sif);
+        match r {
+            Some(f) => f,
+            None => panic!("OOM (contig span) image load"),
+        }
+    };
+    // PASS 2: copy each PT_LOAD's bytes at its offset.
+    let span_virt = kernel_kit::paging::phys_to_virt(span_phys) as *mut u8;
+    for i in 0..phnum {
+        let phdr_ptr = unsafe { elf_bytes.as_ptr().add(phoff + i * core::mem::size_of::<kernel_kit::elf::Elf64_Phdr>()) as *const kernel_kit::elf::Elf64_Phdr };
+        let phdr = unsafe { &*phdr_ptr };
+        if phdr.p_type == 1 {
+            let vaddr = phdr.p_vaddr;
+            let offset = phdr.p_offset as usize;
+            let filesz = phdr.p_filesz as usize;
+            let memsz = phdr.p_memsz as usize;
+            let off_in_span = (vaddr - span_start_vaddr) as usize;
+            unsafe {
+                if filesz > 0 {
+                    core::ptr::copy_nonoverlapping(
+                        elf_bytes.as_ptr().add(offset),
+                        span_virt.add(off_in_span),
+                        filesz,
+                    );
+                }
+                if memsz > filesz {
+                    core::ptr::write_bytes(
+                        span_virt.add(off_in_span + filesz),
+                        0,
+                        memsz - filesz,
+                    );
+                }
+            }
+        }
+    }
+    // Map the whole span in one call. Each leaf PTE is written exactly
+    // once; no boundary-page overwrite.
+    kernel_kit::paging::map_segment(new_cr3, span_start_vaddr, span_phys, span_bytes);
+
+    // Map a fresh user stack (8 KiB ending at 0xFFFFFFFF80100000).
+    unsafe {
+        let stack_vaddr = 0xFFFFFFFF800FE000;
+        let stack_size = 8192;
+        let stack_phys = {
+            let (fa, sif) = kernel_kit::memory::FRAME_ALLOCATOR.lock();
+            let r = fa.alloc_contiguous(2); // 8 KiB = 2 frames
+            kernel_kit::memory::FRAME_ALLOCATOR.unlock(sif);
+            match r {
+                Some(f) => f,
+                None => panic!("OOM (contig 2) user stack"),
+            }
+        };
+        core::ptr::write_bytes(
+            kernel_kit::paging::phys_to_virt(stack_phys) as *mut u8,
+            0, stack_size,
+        );
+        kernel_kit::paging::map_segment(new_cr3, stack_vaddr, stack_phys, stack_size);
+    }
+
+    Some((ehdr.e_entry, new_cr3))
+}

+fn serial_str(s: &str) {
+    let (sport, sif) = kernel_kit::serial::SERIAL1.lock();
+    for &b in s.as_bytes() {
+        sport.send(b);
+    }
+    kernel_kit::serial::SERIAL1.unlock(sif);
+}
+
+fn serial_u64(v: u64) {
+    let mut buf = [0u8; 20];
+    let s = u64_to_dec(v, &mut buf);
+    let (sport, sif) = kernel_kit::serial::SERIAL1.lock();
+    for &b in s {
+        sport.send(b);
+    }
+    kernel_kit::serial::SERIAL1.unlock(sif);
+}

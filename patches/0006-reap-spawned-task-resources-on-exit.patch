+/// Return a terminated task's recorded resources to the frame allocator
+/// (patch 0006). Called by the scheduler when a Terminated slot is reused,
+/// so some other task has run since termination: the dead task's CR3 is no
+/// longer loaded and nothing references its kernel stack. Zero metadata
+/// fields skip — boot-spawned tasks (heap kernel stacks, no recorded
+/// bookkeeping) therefore reap as no-ops.
+///
+/// Scope: kernel stack frame, image span, user stack, and the task's PRIVATE
+/// page-table frames (diff-walk against parent_pml4). Data frames referenced
+/// by leaf PTEs are never freed by the walk itself: the image/stack runs are
+/// freed from the recorded metadata, and per-pid IPC RECV frames stay cached
+/// in IPC_PAGES for reuse. Address spaces replaced by SYS_EXEC still leak in
+/// this patch (their roots are not recorded as anyone's parent for freeing);
+/// that is the next candidate.
+pub fn reap_context(ctx: &kernel_kit::context::Context) {
+    let mut freed: usize = 0;

+/// Release every page-table frame that `child` owns privately relative to
+/// `parent` — the CR3 that `child` was duplicated from (patch 0006).
+///
+/// `duplicate_pml4` is a shallow copy and `unshare_page_path` copies table
+/// contents, so a private subtree can still contain entries pointing at
+/// tables shared with the parent. The walk therefore diffs each level
+/// against the parent's same-slot entry: a frame whose parent slot points
+/// at the SAME frame is shared and left alone; a frame whose parent slot
+/// differs (or is absent) is private and released recursively.
+///
+/// Only page-table frames are released. Leaf data frames (image spans, user
+/// stacks, cached IPC RECV frames) are never touched here — their owners
+/// track and free them separately. Huge-page entries (bit 7) are skipped:
+/// they are data mappings copied from the parent, never privately allocated.
+///
+/// Contract: `child` must not be any running task's active CR3, and
+/// `parent` must still be valid memory (a live task's root or a root that
+/// is leaked-but-never-freed). Returns the number of frames released.
+pub fn free_private_tables(child_pml4: u64, parent_pml4: u64) -> usize {
+    if child_pml4 == 0 || parent_pml4 == 0 || child_pml4 == parent_pml4 {
+        return 0;
+    }
+    let mut freed = 0;
+    unsafe {
+        let child = &*(phys_to_virt(child_pml4) as *const PageTable);
+        let parent = &*(phys_to_virt(parent_pml4) as *const PageTable);
+        for i in 0..512 {
+            let c = child.entries[i].0;
+            if (c & 1) == 0 { continue; }
+            if (c & (1 << 7)) != 0 { continue; } // reserved at PML4; skip defensively
+            let c_addr = c & 0x000FFFFFFFFFF000;
+            let p = parent.entries[i].0;
+            if (p & 1) != 0 && (p & 0x000FFFFFFFFFF000) == c_addr {
+                continue; // shared subtree
+            }
+            let parent_next = if (p & 1) != 0 {
+                Some(p & 0x000FFFFFFFFFF000)
+            } else {
+                None
+            };
+            // The PML4 entry targets a PDPT: level 3 (PDPT->PD->PT below).
+            freed += free_table_subtree(c_addr, parent_next, 3);
+            free_one_frame(c_addr);
+            freed += 1;
+        }
+    }
+    free_one_frame(child_pml4);
+    freed + 1
+}
+
+/// Release the private part of one page-table frame's subtree. `level` is
+/// the level of `tbl_phys` itself: 3 = PDPT, 2 = PD, 1 = PT. At level 1 the
+/// entries point at 4 KiB data frames, which are never released here.
+/// Returns the number of frames released below `tbl_phys` (not counting
+/// `tbl_phys` itself).
+unsafe fn free_table_subtree(tbl_phys: u64, parent_tbl: Option<u64>, level: usize) -> usize {
+    let mut freed = 0;
+    let tbl = &*(phys_to_virt(tbl_phys) as *const PageTable);
+    for i in 0..512 {
+        let e = tbl.entries[i].0;
+        if (e & 1) == 0 { continue; }
+        if (e & (1 << 7)) != 0 { continue; } // huge leaf: data, copied from parent
+        let e_addr = e & 0x000FFFFFFFFFF000;
+        let mut pe: u64 = 0;
+        if let Some(pt_phys) = parent_tbl {
+            let pt = &*(phys_to_virt(pt_phys) as *const PageTable);
+            pe = pt.entries[i].0;
+            if (pe & 1) != 0 && (pe & 0x000FFFFFFFFFF000) == e_addr {
+                continue; // shared at this level too
+            }
+        }
+        if level > 1 {
+            let parent_next = if (pe & 1) != 0 {
+                Some(pe & 0x000FFFFFFFFFF000)
+            } else {
+                None
+            };
+            freed += free_table_subtree(e_addr, parent_next, level - 1);
+            free_one_frame(e_addr);
+            freed += 1;
+        }
+        // level == 1: e_addr is a leaf data frame — tracked elsewhere.
+    }
+    freed
+}
+
+fn free_one_frame(phys: u64) {
+    let (fa, sif) = crate::memory::FRAME_ALLOCATOR.lock();
+    fa.free_frame(phys);
+    crate::memory::FRAME_ALLOCATOR.unlock(sif);
+}

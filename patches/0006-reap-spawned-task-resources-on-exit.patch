+/// Serialize a u64 as decimal into `buf`, returning the written slice.
+fn u64_to_dec(mut v: u64, buf: &mut [u8; 20]) -> &[u8] {
+    let mut n = 0;
+    if v == 0 {
+        buf[0] = b'0';
+        return &buf[..1];
+    }
+    while v > 0 {
+        buf[n] = b'0' + (v % 10) as u8;
+        v /= 10;
+        n += 1;
+    }
+    for i in 0..n / 2 {
+        buf.swap(i, n - 1 - i);
+    }
+    &buf[..n]
+}

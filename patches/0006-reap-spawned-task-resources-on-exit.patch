+    for i in 0..ctx.image_span_frames {
+        free_one(ctx.image_span_phys + (i as u64) * 4096);
+        freed += 1;
+    }
+    for i in 0..ctx.user_stack_frames {
+        free_one(ctx.user_stack_phys + (i as u64) * 4096);
+        freed += 1;
+    }
+
+    if freed > 0 {
+        let free_after = {
+            let (fa, sif) = kernel_kit::memory::FRAME_ALLOCATOR.lock();
+            let n = fa.free_count();
+            kernel_kit::memory::FRAME_ALLOCATOR.unlock(sif);
+            n
+        };
+        serial_str("\nREAP pid=");
+        serial_u64(ctx.id as u64);
+        serial_str(" freed=");
+        serial_u64(freed as u64);
+        serial_str(" free=");
+        serial_u64(free_after as u64);
+    }

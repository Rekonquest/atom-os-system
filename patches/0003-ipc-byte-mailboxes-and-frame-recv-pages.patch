+/// Byte mailboxes for IPC: one single-slot box per pid, latest message wins.
+/// Runs ALONGSIDE the field's energy transport (which stays untouched) so
+/// SYS_IPC_SEND/RECV deliver actual message bytes again.
+const IPC_MAX_PIDS: usize = 16;
+const IPC_MAX_BYTES: usize = 255;
+
+#[derive(Clone, Copy)]
+struct IpcMailbox {
+    len: usize,
+    bytes: [u8; IPC_MAX_BYTES],
+}
+
+impl IpcMailbox {
+    const fn new() -> Self {
+        Self { len: 0, bytes: [0u8; IPC_MAX_BYTES] }
+    }
+}
+
+static IPC_MAILBOXES: kernel_kit::memory::IrqSpinlock<[IpcMailbox; IPC_MAX_PIDS]> =
+    kernel_kit::memory::IrqSpinlock::new([IpcMailbox::new(); IPC_MAX_PIDS]);
+
+/// One RECV page per pid, allocated once from the frame allocator and reused.
+/// Replaces the old per-RECV slab allocation, which (a) leaked a 4 KiB page
+/// on every ready RECV and (b) fed `virt_to_phys(heap_ptr)` into a PTE even
+/// though kernel-heap virtual addresses are NOT inside the bootloader's
+/// physical-offset window — producing reserved-bit physical addresses and a
+/// user-mode #PF (EC=0xC, CR2=0x300000) the first time RECV returned a page.
+static IPC_PAGES: [core::sync::atomic::AtomicU64; IPC_MAX_PIDS] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; IPC_MAX_PIDS];
+
+fn ipc_page_phys(pid: usize) -> Option<u64> {
+    if pid >= IPC_MAX_PIDS {
+        return None;
+    }
+    let cached = IPC_PAGES[pid].load(core::sync::atomic::Ordering::Acquire);
+    if cached != 0 {
+        return Some(cached);
+    }
+    let (fa, sif) = kernel_kit::memory::FRAME_ALLOCATOR.lock();
+    let frame = fa.alloc_frame();
+    kernel_kit::memory::FRAME_ALLOCATOR.unlock(sif);
+    let frame = frame?;
+    match IPC_PAGES[pid].compare_exchange(
+        0, frame,
+        core::sync::atomic::Ordering::AcqRel,
+        core::sync::atomic::Ordering::Acquire,
+    ) {
+        Ok(_) => Some(frame),
+        Err(existing) => {
+            let (fa, sif) = kernel_kit::memory::FRAME_ALLOCATOR.lock();
+            fa.free_frame(frame);
+            kernel_kit::memory::FRAME_ALLOCATOR.unlock(sif);
+            Some(existing)
+        }
+    }
+}
